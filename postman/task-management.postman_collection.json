                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('All rows succeeded', function () {",
                  "  pm.expect(data.total).to.eql(2);",
                  "  pm.expect(data.createdCount).to.eql(2);",
                  "  pm.expect(data.failedCount).to.eql(0);",
                  "  pm.expect(data.results).to.be.an('array').with.lengthOf(2);",
                  "  data.results.forEach((item) => {",
                  "    pm.expect(item.ok).to.eql(true);",
                  "    pm.expect(item.taskId).to.be.a('string').and.not.empty;",
                  "    pm.expect(item.projectId).to.eql(pm.environment.get('project_id'));",
                  "  });",
                  "});",
                  "pm.environment.set('batch_created_task_id', data.results[0].taskId);",
                  "pm.environment.set('task_id', data.results[0].taskId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
