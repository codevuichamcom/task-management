            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"clientRef\": \"row-101\",\n      \"title\": \"{{batch_all_valid_prefix}} - A\",\n      \"description\": \"All valid batch row A\",\n      \"status\": \"TODO\",\n      \"projectId\": \"{{project_id}}\",\n      \"assigneeId\": \"{{assignee_id}}\"\n    },\n    {\n      \"clientRef\": \"row-102\",\n      \"title\": \"{{batch_all_valid_prefix}} - B\",\n      \"description\": \"All valid batch row B\",\n      \"status\": \"IN_PROGRESS\",\n      \"projectId\": \"{{project_id}}\",\n      \"assigneeId\": \"{{assignee_id}}\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
