  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register - Random User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set('register_email', `postman.user.${ts}@test.com`);",
                  "pm.environment.set('register_password', 'Postman123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Response schema - register', function () {",
                  "  pm.expect(data.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.email).to.eql(pm.environment.get('register_email'));",
                  "  pm.expect(data.role).to.be.oneOf(['USER', 'ADMIN']);",
                  "});",
                  "pm.environment.set('registered_user_id', data.id);",
                  "pm.environment.set('registered_user_email', data.email);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "response": []
        },
        {
          "name": "Login - Seed User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Response schema - login', function () {",
                  "  pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.user).to.be.an('object');",
                  "  pm.expect(data.user.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.user.email).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('access_token', data.access_token);",
                  "pm.environment.set('current_user_id', data.user.id);",
                  "pm.environment.set('current_user_email', data.user.email);",
                  "if (!pm.environment.get('assignee_id')) { pm.environment.set('assignee_id', data.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Projects",
      "item": [
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('project_name', `Postman Project ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Response schema - create project', function () {",
                  "  pm.expect(data.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.name).to.eql(pm.environment.get('project_name'));",
                  "  pm.expect(data.ownerId).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.createdAt).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('project_id', data.id);",
                  "pm.environment.set('project_owner_id', data.ownerId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{project_name}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/projects"
          },
          "response": []
        },
        {
          "name": "List My Projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "const projectId = pm.environment.get('project_id');",
                  "pm.test('Response is an array', function () { pm.expect(data).to.be.an('array'); });",
                  "pm.test('Array items have project schema', function () {",
                  "  data.forEach((item) => {",
                  "    pm.expect(item.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(item.name).to.be.a('string');",
                  "    pm.expect(item.ownerId).to.be.a('string').and.not.empty;",
                  "    pm.expect(item.createdAt).to.be.a('string').and.not.empty;",
                  "  });",
                  "});",
                  "if (projectId) {",
                  "  pm.test('Created project appears in my list', function () {",
                  "    pm.expect(data.some((item) => item.id === projectId)).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects"
          },
          "response": []
        },
